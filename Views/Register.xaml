
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Ofek_List.RegisterPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="White">

    <ScrollView>
        <Grid
            Padding="30"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="400">

            <VerticalStackLayout Spacing="14">

                <Label
                    Text="Ligat Fantasy"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#222222"
                    HorizontalOptions="Center" />

                <Label
                    Text="Create an account"
                    FontSize="22"
                    TextColor="#222222"
                    HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="5">
                    <Label Text="Full Name" TextColor="#222222" />
                    <Entry
                        x:Name="NameEntry"
                        Placeholder="Enter your full name"
                        TextColor="#222222"
                        PlaceholderColor="#888888"
                        BackgroundColor="#F5F5F5" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" TextColor="#222222" />
                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Enter your email"
                        Keyboard="Email"
                        TextColor="#222222"
                        PlaceholderColor="#888888"
                        BackgroundColor="#F5F5F5" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Username" TextColor="#222222" />
                    <Entry
                        x:Name="UsernameEntry"
                        Placeholder="Choose a username"
                        TextColor="#222222"
                        PlaceholderColor="#888888"
                        BackgroundColor="#F5F5F5" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Password" TextColor="#222222" />
                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="At least 8 characters"
                        IsPassword="True"
                        TextColor="#222222"
                        PlaceholderColor="#888888"
                        BackgroundColor="#F5F5F5" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Confirm Password"
                           TextColor="#222222" />
                    <Entry
                        x:Name="ConfirmPasswordEntry"
                        Placeholder="Enter your password again"
                        IsPassword="True"
                        TextColor="#222222"
                        PlaceholderColor="#888888"
                        BackgroundColor="#F5F5F5" />
                </VerticalStackLayout>

                <Label
                    x:Name="MessageLabel"
                    Text=""
                    TextColor="Red"
                    FontSize="13" />

                <Button
                    x:Name="RegisterButton"
                    Text="Register"
                    BackgroundColor="#E5BD35"
                    TextColor="#222222"
                    FontAttributes="Bold"
                    CornerRadius="6"
                    HeightRequest="48"
                    Clicked="RegisterButton_Clicked" />

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="4">

                    <Label
                        Text="Already have an account?"
                        TextColor="#555555"
                        VerticalOptions="Center" />

                    <Label
                        Text="Login"
                        TextColor="#1683FF"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="LoginButton_Clicked" />
                        </Label.GestureRecognizers>
                    </Label>

                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
